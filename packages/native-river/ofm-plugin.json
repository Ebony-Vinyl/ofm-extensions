{
  "schemaVersion": 1,
  "id": "native-river",
  "version": "1.0.2",
  "type": "channel",
  "name": "River（OFM 原生）",
  "description": "由 OFM 保存本人凭据并直连厂商模型目录与 Chat 接口；无需 Magpie 或本地渠道桥。",
  "summary": "由 OFM 保存本人凭据并直连厂商模型目录与 Chat 接口；无需 Magpie 或本地渠道桥。",
  "author": "OFM Extensions maintainers",
  "license": "MIT",
  "minHost": "2.8.2",
  "requires": [
    "native-auth"
  ],
  "repository": "https://github.com/Ebony-Vinyl/ofm-extensions",
  "homepage": "https://github.com/Ebony-Vinyl/ofm-extensions",
  "permissions": {
    "network": [
      "https://api.river.ai"
    ],
    "secrets": [
      "account"
    ],
    "storage": false
  },
  "config": [
    {
      "key": "accountId",
      "type": "text",
      "label": "账号 ID",
      "default": "default"
    }
  ],
  "tags": [
    "auth",
    "channel",
    "native"
  ],
  "publishedAt": "2026-11-08T00:00:00.000Z",
  "changelog": [
    "1.0.2 — 合并可核验 id 能力表，未知模型保持保守",
    "1.0.1 — 认证表单、methodId 校验与凭据隔离；去除借用客户端身份",
    "1.0.0 — OFM 原生认证与厂商直连"
  ],
  "files": [
    "main.mjs"
  ]
}
