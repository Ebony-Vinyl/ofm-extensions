{
  "schemaVersion": 1,
  "id": "native-commandcode",
  "version": "1.0.0",
  "type": "channel",
  "name": "Command Code Provider API（OFM 原生）",
  "description": "本人非 Go 计划 Provider API key；Chat、Responses、Messages；不支持 Go /alpha/generate 或 CLI 登录。",
  "summary": "本人非 Go 计划 Provider API key；Chat、Responses、Messages；不支持 Go /alpha/generate 或 CLI 登录。",
  "author": "OFM Extensions maintainers",
  "license": "MIT",
  "minHost": "2.8.2",
  "requires": [
    "native-auth"
  ],
  "repository": "https://github.com/Ebony-Vinyl/ofm-extensions",
  "homepage": "https://github.com/Ebony-Vinyl/ofm-extensions",
  "permissions": {
    "network": [
      "https://api.commandcode.ai"
    ],
    "secrets": [
      "account"
    ],
    "storage": false
  },
  "config": [
    {
      "key": "accountId",
      "type": "text",
      "label": "账号 ID",
      "default": "default"
    }
  ],
  "tags": [
    "auth",
    "channel",
    "native"
  ],
  "publishedAt": "2026-11-08T00:00:00.000Z",
