{
  "schemaVersion": 1,
  "id": "native-deepai-code",
  "version": "1.0.0",
  "type": "channel",
  "name": "DeepAI Code（OFM 原生）",
  "description": "本人 API Key + 本人真实设备指纹直连动态模型和 Chat/Responses。验钥可能触发当日设备额度；不生成/派生/轮换指纹，不读取桌面凭据，浏览器登录未迁移。",
  "summary": "区别于 deepai-code：使用 OFM 原生账号库和授权表单，不用普通 secrets 配置。API-only；需本人真实设备 SHA-256，不伪造身份或绕过额度。",
  "author": "OFM Extensions maintainers",
  "license": "MIT",
  "minHost": "2.8.2",
  "requires": [
    "native-auth"
  ],
  "repository": "https://github.com/Ebony-Vinyl/ofm-extensions",
  "homepage": "https://github.com/Ebony-Vinyl/ofm-extensions",
  "permissions": {
    "network": [
      "https://api.deepai.org"
    ],
    "secrets": [
      "account"
    ],
    "storage": false
  },
  "config": [
    {
      "key": "accountId",
      "type": "text",
      "label": "账号 ID",
      "default": "default"
    }
  ],
  "tags": [
    "auth",
    "channel",
    "native"
  ],
  "publishedAt": "2026-11-08T00:00:00.000Z",
  "changelog": [
    "1.0.0 — OFM 原生认证与厂商直连"
  ],
  "files": [
    "main.mjs"
  ]
}
