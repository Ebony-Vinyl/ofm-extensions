{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/Ebony-Vinyl/ofm-extensions/main/schema/ofm-extension.schema.json",
  "title": "OFM extension manifest",
  "description": "The ofm-plugin.json manifest of an OFM Extensions package. CI validates manifests against the host's normalization rules with marketplace policy on top; unknown fields are rejected, so what CI approves is exactly what the host reads.",
  "type": "object",
  "required": ["schemaVersion", "id", "version", "type", "name", "description", "author", "license", "minHost", "permissions"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "requires": { "type": "array", "maxItems": 16, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" } },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,47}$",
      "description": "Lowercase package id; must equal the directory name under packages/."
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[\\w.]+)?$",
      "description": "Semver. Each release bumps this; the registry entry and the installed record both carry it."
    },
    "type": { "enum": ["channel", "enhancement"] },
    "name": { "type": "string", "maxLength": 64 },
    "main": {
      "type": "string",
      "pattern": "^[\\w.-]+\\.mjs$",
      "default": "main.mjs",
      "description": "Must be main.mjs — the registry format ships exactly one source file per package."
    },
    "description": { "type": "string", "minLength": 1, "maxLength": 400 },
    "author": { "type": "string", "minLength": 1, "maxLength": 80 },
    "license": { "type": "string", "pattern": "^[\\w.()+-]{1,40}$", "description": "SPDX expression, e.g. MIT." },
    "homepage": { "type": "string", "pattern": "^https://" },
    "repository": { "type": "string", "pattern": "^https://" },
    "icon": { "type": "string", "maxLength": 200 },
    "cover": {
      "type": "string",
      "pattern": "^[\\w.-]+\\.(?:png|jpe?g|webp|svg)$",
      "description": "Optional display-only cover image inside the package directory (png/jpg/jpeg/webp/svg, ≤192 KB). The registry build hashes it like main.mjs; the host verifies the digest before rendering. SVG covers must be script-free."
    },
    "minHost": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[\\w.]+)?$",
      "description": "Oldest host version the package supports. The current platform floor is 2.8.1."
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["network", "secrets", "storage"],
      "properties": {
        "network": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^https?:\\/\\/",
            "maxLength": 128,
            "description": "An origin. https always; plain http only for loopback hosts (127.0.0.1, localhost, [::1])."
          }
        },
        "secrets": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[\\w-]{1,64}$" }
        },
        "storage": { "type": "boolean", "default": false }
      }
    },
    "replaces": {
      "enum": ["kilo"],
      "description": "The built-in lane this channel takes over. Marketplace policy currently allows only 'kilo'."
    },
    "hooks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": { "enum": ["onRequest", "onModels", "onUsage"] },
      "description": "Enhancement packages only. Channels must not declare hooks."
    },
    "models": {
      "type": "array",
      "maxItems": 256,
      "description": "Channel packages only: the static model list the host serves without calling listModels.",
      "items": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 128 },
          "name": { "type": "string", "maxLength": 200 },
          "contextWindow": { "type": "number", "exclusiveMinimum": 0 },
          "maxOutput": { "type": "number", "exclusiveMinimum": 0 },
          "vision": { "type": "boolean" },
          "reasoning": { "type": "boolean" },
          "wire": { "enum": ["chat", "responses", "messages"] }
        }
      }
    },
    "config": {
      "type": "array",
      "maxItems": 12,
      "description": "Settings the host renders for the user and hands the module as ctx.config.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "type", "default"],
        "properties": {
          "key": { "type": "string", "pattern": "^[\\w-]{1,64}$" },
          "type": { "enum": ["text", "password", "toggle", "number", "select"] },
          "label": { "type": "string", "maxLength": 80 },
          "description": { "type": "string", "maxLength": 200 },
          "default": true,
          "options": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "items": { "type": "string" }
          }
        },
        "allOf": [
          { "if": { "properties": { "type": { "const": "toggle" } } }, "then": { "properties": { "default": { "type": "boolean" } } } },
          { "if": { "properties": { "type": { "const": "number" } } }, "then": { "properties": { "default": { "type": "number" } } } },
          { "if": { "properties": { "type": { "enum": ["text", "password"] } } }, "then": { "properties": { "default": { "type": "string" } } } },
          { "if": { "properties": { "type": { "const": "select" } } }, "then": { "required": ["options"], "properties": { "default": { "type": "string" } } } }
        ]
      }
    },
    "summary": {
      "type": "string",
      "maxLength": 300,
      "description": "Registry metadata (not a host manifest field): one-line card text for the marketplace page."
    },
    "tags": {
      "type": "array",
      "maxItems": 8,
      "items": { "type": "string" },
      "description": "Registry metadata: free-form tags; the build sorts and dedupes them."
    },
    "publishedAt": {
      "type": "string",
      "description": "Registry metadata: ISO date of first publication. Set it when the package first merges; leave it alone afterwards."
    },
    "changelog": {
      "type": "array",
      "maxItems": 8,
      "items": { "type": "string", "minLength": 1, "maxLength": 200 },
      "description": "Registry metadata: newest-first release notes the marketplace detail view renders. One line per entry, most recent first; update the top entry (or prepend a new one) whenever version bumps."
    }
  }
}
